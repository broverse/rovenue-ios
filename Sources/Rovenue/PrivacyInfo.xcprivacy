  <!--
    Required-reason APIs the SDK's own code references (statically linked into
    the app, so only this manifest can answer for them). Audited against every
    shipped binary by e2e/live/privacy-manifest-audit.mjs.
    FileTimestamp C617.1: stat/fstat/lstat in the bundled SQLite, Rust std and
      tokio, on files in the app container (the cache database); the funnel
      image disk cache reads and sets modification dates under Caches/.
    DiskSpace E174.1: statfs/fstatfs in the bundled SQLite, which reads the
      volume of the database file when opening it to decide how to write to it
      (read-only mount, msdos/exfat, network file systems). Nothing derived
      leaves the device.
  -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key><string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>C617.1</string></array>
    </dict>
    <dict>
      <key>NSPrivacyAccessedAPIType</key><string>NSPrivacyAccessedAPICategoryDiskSpace</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array><string>E174.1</string></array>
    </dict>
  </array>
</dict>
</plist>
